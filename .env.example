# 复制本文件为 .env.local 并填写你自己的部署地址
#
# 指向扩展文件所在的目录，必须以 / 结尾。
# 这个值会用于：
#   1. 生成 dist/manifest.json 里的 icon / popover / background_url
#   2. 生成 dist/*.html 里引用的 assets/*.js 绝对路径
#
# 例：
#   VITE_DEPLOY_BASE=https://example.com/status-peek/
#   VITE_DEPLOY_BASE=https://status-peek.example.com/
#
VITE_DEPLOY_BASE=
